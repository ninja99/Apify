{
  "title": "Custom FB Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "requestQueueRef": {
      "title": "Request Queue",
      "type": "string",
      "description": "Select the Request Queue to consume URLs from.",
      "editor": "resourcePicker",
      "resourceType": "requestQueue",
      "resourcePermissions": [
        "READ",
        "WRITE"
      ]
    },
    "maxRequestsPerCrawl": {
      "title": "Max requests per crawl",
      "type": "integer",
      "description": "Safety cap for how many URLs to process in this run.",
      "editor": "number"
    },
    "proxyGroups": {
      "title": "Proxy groups",
      "type": "array",
      "description": "Optional Apify proxy groups, e.g. [\"RESIDENTIAL\"].",
      "editor": "json",
      "items": {
        "type": "string"
      }
    },
    "proxyCountryCode": {
      "title": "Proxy country code",
      "type": "string",
      "description": "ISO country code, e.g. \"US\".",
      "editor": "textfield",
      "default": "US"
    }
  },
  "required": [
    "requestQueueRef"
  ]
}